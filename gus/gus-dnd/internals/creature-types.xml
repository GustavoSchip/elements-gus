<elements>
    <info>
        <name>Creature Types</name>
        <description>The construction for my custom Creature Types.</description>
        <author url="https://github.com/GustavoSchip/">Gustavo Schip</author>
        <update version="0.0.1">
            <!-- This file -->
            <file name="creature-types.xml" url="https://raw.githubusercontent.com/GustavoSchip/elements-gus/master/gus/gus-dnd/internals/creature-types.xml" />
        </update>
    </info>
    <element id="ID_INTERNAL_INFORMATION_CREATURE_TYPE_ABERRATION" name="Aberration" source="Internal" type="Information">
        <compendium display="false" />
        <description>
            <p>Your creature type is Aberration.</p>
        </description>
    </element>
    <element id="ID_INTERNAL_ITEM_CREATURE_TYPE_ABERRATION" name="Creature Type, Aberration" source="Internal" type="Item">
        <compendium display="false" />
        <description>
            <p>
                <i>You can equip this item to “enable” it. It remains hidden from the inventory on your character sheet.</i>
            </p>
            <div class="reference">
                <div element="ID_INTERNAL_INFORMATION_CREATURE_TYPE_ABERRATION" />
            </div>
        </description>
        <setters>
            <set name="category">Additional Creature Type</set>
            <set name="slot">misc</set>
            <set name="inventory-hidden">true</set>
        </setters>
        <rules>
            <grant id="ID_INTERNAL_RACIAL_TRAIT_TYPE_ABERRATION" type="Racial Trait" />
        </rules>
    </element>
