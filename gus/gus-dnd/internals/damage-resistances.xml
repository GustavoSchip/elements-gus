    <element id="ID_INTERNAL_ITEM_CONDITION_DAMAGE_RESISTANCE_ACID" name="Additional Resistance, Acid" source="Internal" type="Item">
        <compendium display="false" />
        <description>
            <p>
                <i>You can equip this item to “enable” it. It remains hidden from the inventory on your character sheet.</i>
            </p>
            <div class="reference">
                <div element="ID_INTERNAL_INFORMATION_CONDITION_DAMAGE_RESISTANCE_ACID" />
            </div>
        </description>
        <setters>
            <set name="category">Additional Resistance</set>
            <set name="slot">misc</set>
            <set name="inventory-hidden">true</set>
        </setters>
        <rules>
            <grant id="ID_INTERNAL_CONDITION_DAMAGE_RESISTANCE_ACID" type="Condition" />
        </rules>
    </element>
    <element id="ID_INTERNAL_INFORMATION_CONDITION_DAMAGE_RESISTANCE_ACID" name="Acid" source="Internal" type="Information">
        <compendium display="false" />
        <description>
            <p>You are resistant to Acid damage.</p>
        </description>
    </element>
